# dependencies
node_modules/

# next.js build output
.next/
out/

# environment variables (contains secrets — never commit)
.env
.env.local
.env*.local

# typescript
tsconfig.tsbuildinfo

# misc
.DS_Store
*.pem
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# claude code（只提交制度檔，其餘一律忽略）
# 新增要提交的子項時，記得同步加白名單並用 git check-ignore -v 驗證
.claude/*
!.claude/agents/
!.claude/agent-memory/
!.claude/playbooks/
!.claude/backups/
!.claude/commands/
!.claude/skills/
!.claude/hooks/
!.claude/settings.json
!.claude/WORKLOG.md
.claude/settings.local.json
.vercel

# .env 的備份絕不進 repo（backups/ 是白名單放行的，會被誤掃進 commit）
.claude/backups/env*
