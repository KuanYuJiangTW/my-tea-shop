# ── 綠界金流 ──────────────────────────────────────
ECPAY_MERCHANT_ID=
ECPAY_HASH_KEY=
ECPAY_HASH_IV=

# ── 綠界物流（超商地圖） ────────────────────────────
ECPAY_LOGISTICS_HASH_KEY=
ECPAY_LOGISTICS_HASH_IV=

# ── Stripe 國際金流（可選） ────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# ── PayPal 國際金流 ──────────────────────────────────
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_MODE=sandbox

# ── 網站網址（本地開發用 ngrok 等工具） ─────────────
NEXT_PUBLIC_BASE_URL=https://your-domain.com

# ── Resend Email ──────────────────────────────────
RESEND_API_KEY=
RESEND_FROM_EMAIL=霧抉茶 <noreply@your-domain.com>
ADMIN_EMAIL=

# ── Supabase ──────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Google Analytics（可選） ──────────────────────
NEXT_PUBLIC_GA_ID=

# ── 管理後台登入密碼 ───────────────────────────────
ADMIN_PASSWORD=

# ── Vercel Cron 保護密鑰（隨機字串，需在 Vercel 環境變數設定相同值） ──
CRON_SECRET=

# ── 產品頁快取 Revalidation 密鑰（隨機字串，需在 Vercel 環境變數設定相同值） ──
REVALIDATE_SECRET=

# ── Sanity Webhook 驗證密鑰（需在 Sanity 與 Vercel 環境變數設定相同值） ──
SANITY_WEBHOOK_SECRET=

# ── AI 聊天小幫手（Groq） ──────────────────────
GROQ_API_KEY=
# 全站每日聊天總量上限（防止刷爆 Groq 額度，未設定預設 1000）
CHAT_DAILY_LIMIT=1000

# ── 霧抉茶 LINE（@976jhznk）：AI 小幫手轉真人、茶山體驗詢問 ───────────
NEXT_PUBLIC_LINE_TEA_URL=

# ── 風土數位 LINE（@580ariqa）：報價頁 /web-design 專用；未設定則不顯示 LINE 按鈕 ───────────
NEXT_PUBLIC_LINE_TERROIR_URL=

# ── LINE Tag（廣告成效追蹤，可選）：後台 資料管理 → 追蹤（LINE Tag）取得 ───────────
# 未設定就不載入追蹤碼（本機與 Preview 預設不要設，避免汙染正式報表）
NEXT_PUBLIC_LINE_TAG_ID=
