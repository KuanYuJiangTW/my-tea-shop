# ── 綠界金流 ──────────────────────────────────────
ECPAY_MERCHANT_ID=
ECPAY_HASH_KEY=
ECPAY_HASH_IV=

# ── 綠界物流（超商地圖） ────────────────────────────
ECPAY_LOGISTICS_HASH_KEY=
ECPAY_LOGISTICS_HASH_IV=

# ── Stripe 國際金流（可選） ────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# ── PayPal 國際金流 ──────────────────────────────────
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_MODE=sandbox

# ── 網站網址（本地開發用 ngrok 等工具） ─────────────
NEXT_PUBLIC_BASE_URL=https://your-domain.com

# ── Resend Email ──────────────────────────────────
RESEND_API_KEY=
RESEND_FROM_EMAIL=霧抉茶 <noreply@your-domain.com>
ADMIN_EMAIL=

# ── Supabase ──────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Google Analytics（可選） ──────────────────────
NEXT_PUBLIC_GA_ID=

# ── 管理後台登入密碼 ───────────────────────────────
ADMIN_PASSWORD=

# ── Vercel Cron 保護密鑰（隨機字串，需在 Vercel 環境變數設定相同值） ──
CRON_SECRET=

# ── 產品頁快取 Revalidation 密鑰（隨機字串，需在 Vercel 環境變數設定相同值） ──
REVALIDATE_SECRET=

# ── Sanity Webhook 驗證密鑰（需在 Sanity 與 Vercel 環境變數設定相同值） ──
SANITY_WEBHOOK_SECRET=

# ── AI 聊天小幫手（Groq） ──────────────────────
GROQ_API_KEY=

# ── LINE 官方帳號（AI 小幫手轉真人用） ───────────
NEXT_PUBLIC_LINE_OFFICIAL_URL=
